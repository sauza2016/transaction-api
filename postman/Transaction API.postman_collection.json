      "name": "Transactions",
      "item": [
        {
          "name": "Create Approved Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Transaction id exists\", function () {\r",
                  "    pm.expect(response.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Transaction status is APPROVED\", function () {\r",
                  "    pm.expect(response.status).to.eql(\"APPROVED\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Provider transaction id exists\", function () {\r",
                  "    pm.expect(response.providerTransactionId).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Account id is correct\", function () {\r",
                  "    pm.expect(response.accountId).to.eql(\"ACC-10001\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"accountId\": \"ACC-10001\",\r\n  \"type\": \"CREDIT\",\r\n  \"amount\": 1500.00,\r\n  \"currency\": \"MXN\",\r\n  \"description\": \"Salary deposit\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            }
          },
          "response": []
        },
