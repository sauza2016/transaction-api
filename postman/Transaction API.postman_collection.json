        {
          "name": "Get Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(response).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Transactions are ordered from newest to oldest\", function () {\r",
                  "    for (let index = 1; index < response.length; index++) {\r",
                  "        const previous = new Date(response[index - 1].createdAt);\r",
                  "        const current = new Date(response[index].createdAt);\r",
                  "\r",
                  "        pm.expect(previous.getTime()).to.be.at.least(current.getTime());\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
